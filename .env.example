# Copy to `.env.local` for local development.
# On Vercel: set these in Project → Settings → Environment Variables.

# Canonical site URL (no trailing slash). Used for metadata, OG URLs, and absolute links.
# Local: http://localhost:3000
# Production: https://your-domain.vercel.app
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Stripe (server — never expose secret key to the client)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Stripe (client — safe to expose with NEXT_PUBLIC_)
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=

# Database (e.g. Postgres on Vercel Postgres, Neon, Supabase)
DATABASE_URL=
